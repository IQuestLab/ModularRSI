# OpenAI-compatible model configuration.
MODEL=openai/model-name
API_BASE=https://api.example.com/v1
HARBOR_EVO_API_KEY=change-me
HARBOR_MODEL_INFO='{"max_input_tokens":176000,"max_output_tokens":16000,"input_cost_per_token":0.0,"output_cost_per_token":0.0}'

# Execution environment: docker (default) or e2b.
ENVIRONMENT=docker

# A training dataset is required and must contain tasks/<task-name>/.
SUPPORT_DATASET_DIR=/absolute/path/to/training-dataset

# "train" matches the latest Phase0 scale (10-task windows, cc6, 3 epochs).
# "smoke" changes only scale (2 tasks, cc2, 1 epoch); algorithm semantics stay
# identical.
PROFILE=smoke
ATTEMPTS=3
MAX_LANES=2
AGENT_TIMEOUT_MULTIPLIER=2

# Optional workload overrides. They do not change Phase0's algorithm or gates.
# REFLECT_EVERY=10
# TASK_CONCURRENCY=6
# EPOCHS=3
# MAX_TASKS=30

# Optional E2B configuration when ENVIRONMENT=e2b.
# E2B_API_KEY=change-me

# Optional remote Docker daemon. The address below is documentation-only.
# REMOTE_DOCKER_HOST=tcp://192.0.2.10:2375
# DOCKERHUB_USERNAME=your-dockerhub-username
# DOCKERHUB_TOKEN=your-dockerhub-token

# The single public launcher supports both actions:
#   bash scripts/self_evolve.sh evolve tools
#   bash scripts/self_evolve.sh evaluate
# Evaluation defaults to generations/merged_active and task fix-git. Override
# with MODULES_ROOT, TASK_NAME, DATASET, COMPOSER_NAME, or COMPOSER_SCOPE.
